{
  "name": "dsh-test-plugin",
  "version": "0.1.0",
  "description": "DeepSeek Harness 原生测试计划、执行、断言和报告插件",
  "type": "module",
  "license": "MIT",
  "author": "Pegasus-Yang <panesas2@gmail.com>",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "skills", "templates", "README.md", "doc/user-guide", "doc/deployment"],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "node scripts/e2e.mjs",
    "link:host": "node scripts/link-host.mjs",
    "start:host": "node scripts/start-host.mjs"
  },
  "engines": {"node": ">=22.19.0"},
  "packageManager": "pnpm@11.7.0",
  "dependencies": {"ajv": "8.17.1"},
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/dsh-agent": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-session": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1",
    "@deepseek-ai/dsh-commands": "0.2.1-alpha.1"
  },
  "devDependencies": {"@types/node": "22.19.0", "typescript": "5.9.3", "vitest": "3.2.4", "@playwright/mcp": "0.0.68", "playwright": "1.58.2", "yaml": "2.8.1"}
}
